# Copy this file to docker.env on the server and replace every placeholder.
POSTGRES_DB=lawyerdb
POSTGRES_USER=lawyerapp
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX_VALUE
DATABASE_URL=postgresql://lawyerapp:REPLACE_WITH_LONG_RANDOM_HEX_VALUE@db:5432/lawyerdb?schema=public
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
FRONTEND_URL=https://nyaysaathi.in

# Optional integrations. Set real production credentials when you enable them.
RESEND_API_KEY=
EMAIL_FROM_NAME=NyaySaathi Legal Consultancy
EMAIL_FROM_ADDRESS=support@nyaysaathi.in
LAWYER_PHONE=
LAWYER_EMAIL=
LAWYER_WHATSAPP_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_REDIRECT_URL=https://nyaysaathi.in/consultation/confirmed
PHONEPE_CALLBACK_URL=https://nyaysaathi.in/api/payments/phonepe/callback

# NEXT_PUBLIC_* values are embedded in the frontend during its Docker build.
NEXT_PUBLIC_BACKEND_URL=https://nyaysaathi.in

# Optional admin browser notifications (Firebase Cloud Messaging).
# Read docs/FIREBASE_ADMIN_NOTIFICATIONS.md. These are backend runtime values;
# no NEXT_PUBLIC_FIREBASE_* variables or frontend build arguments are needed.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_VAPID_KEY=
# Private service-account JSON encoded as one base64 line. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_BASE64=
